@startuml search-pipeline
' ============================================================
' Such-Pipeline für die Rechts-Wissensdatenbank
' Hybride Suche (BM25 + Vektoren) mit Zeitfilter, RRF und Reranker
'
' Farbcodierung zeigt, was im lokalen Prototyp (test/) bereits
' umgesetzt wurde und was noch offen ist.
' ============================================================

title Such-Pipeline: Erweiterung durch Glossar & Jev-Klassifikation

skinparam defaultFontName Arial
skinparam ActivityBackgroundColor #F5F7FA
skinparam ActivityBorderColor #4A6FA5
skinparam PartitionBackgroundColor #FFFFFF
skinparam PartitionBorderColor #9AA8BC
skinparam NoteBackgroundColor #F5F7FA
skinparam NoteBorderColor #4A6FA5
skinparam ArrowColor #000000

legend right
  |= Farbe |= Bedeutung |
  |<#CCE0E8>| ursprüngliches Diagramm |
  |<#FFF2A0>| neu hinzugefügt |
endlegend

start

:Kunde gibt Fall ein; <<#CCE0E8>>

partition "1. Vorverarbeitung" {
  :Stichtag / Zeitraum des Sachverhalts
  extrahieren (LLM); <<#CCE0E8>>
  :Normverweise per Regex erkennen
  (z. B. "Art. 28 DSGVO"); <<#CCE0E8>>
  :Suchanfrage aufbereiten
  (ggf. Umformulierung / Fachbegriffe ergänzen); <<#CCE0E8>>
  :Begriffe der Anfrage gegen
  Definitionsbibliothek abgleichen; <<#CCE0E8>>
}

partition "1b. Jev-Klassifikation" {
  :Anfrage an Jev-Modell (TypeSafe AI)
  senden; <<#FFF2A0>>
  :Stufe 1 - pro Gesetz in der DB eine
  Noul-Frage "Ist dieses Gesetz
  einschlägig?" parallel auswerten
  lassen; <<#FFF2A0>>
  :Ergebnis in jev_classifications
  protokollieren; <<#FFF2A0>>
  if (Gesetz-Wahrscheinlichkeit
  >= 50 %?) then (ja)
    :Stufe 2 - pro einzelner Norm
    dieses Gesetzes eine weitere
    Noul-Frage "Ist diese Norm
    einschlägig?" parallel auswerten
    lassen; <<#FFF2A0>>
    :Ergebnis in
    jev_norm_classifications
    protokollieren; <<#FFF2A0>>
  else (nein)
    :Keine Normen-Klassifikation für
    dieses Gesetz - Stufe 2 entfällt,
    um API-Aufrufe zu sparen; <<#FFF2A0>>
  endif
  note right
    NEU: läuft unabhängig vom Zeit-/
    Begriffsfilter (reine Textanalyse,
    kennt den Stichtag nicht). Ergebnis
    wird zusätzlich in der Antwort
    angezeigt (Panel auf der Suchseite
    + Verlauf unter /jev) UND als dritte
    Rangliste in Schritt 3/4 eingespeist
    (sortiert nach Wahrscheinlichkeit,
    siehe Fork-Zweig "Jev-Ranking").
  end note
}

partition "2. Zeit- & Begriffsfilter" {
  :Nur Fassungen berücksichtigen mit
  gültig_von <= Stichtag < gültig_bis
  (inkl. Anwendbarkeit & Übergangsvorschriften); <<#CCE0E8>>
  if (Begriff aus Definitions-
  bibliothek erkannt?) then (ja)
    :Kandidaten auf Normen einschränken,
    die mit diesem Begriff verknüpft sind; <<#CCE0E8>>
  else (nein)
    :Kein Begriffsfilter -
    alle zeitlich gültigen Normen
    bleiben Kandidaten; <<#CCE0E8>>
  endif
}

partition "3. Hybride Suche (parallel)" {
  fork
    :BM25 / Volltextsuche
    (deutscher Analyzer: Stemming,
    Kompositazerlegung); <<#CCE0E8>>
    :Filterung der Treffer; <<#CCE0E8>>
  fork again
    :Vektorsuche
    (Embedding der Anfrage,
    Kosinus-Ähnlichkeit); <<#CCE0E8>>
    :Filterung der Treffer; <<#CCE0E8>>
  fork again
    :Direkter Lookup
    über die Norm-ID; <<#CCE0E8>>
  fork again
    :Jev-Ranking übernehmen
    (Stufe-2-Normen nach
    Wahrscheinlichkeit sortiert); <<#FFF2A0>>
    :Nur am Stichtag gültige (und ggf.
    durch Begriffsfilter erlaubte)
    Normen behalten; <<#FFF2A0>>
    note right
      NEU: macht Jev zur dritten
      Rangliste statt nur zur Anzeige.
      Kein harter Filter - eine von
      Jev hoch bewertete Norm bekommt
      per RRF mehr Gewicht, fällt aber
      nicht automatisch rein, wenn sie
      am Stichtag nicht gültig ist.
    end note
  end fork
}

partition "4. Fusion" {
  :Reciprocal Rank Fusion (RRF) über
  Volltext-, Vektor- und Jev-Rangliste; <<#FFF2A0>>
  :Filterung der Ergebnisse; <<#CCE0E8>>
}

partition "5. Reranking" {
  :Cross-Encoder bewertet
  Frage + Chunk gemeinsam; <<#CCE0E8>>
  :Top 5–15 Chunks behalten; <<#CCE0E8>>
}

partition "6. Graph-Expansion (optional)" {
  if (Verweise / Legaldefinitionen\nim Knowledge Graph?) then (ja)
    :Verwiesene Normen & Definitionen
    ergänzen (gleicher Stichtag); <<#CCE0E8>>
  else (nein)
  endif
}

partition "7. Antwortgenerierung" {
  :LLM erzeugt Antwort
  auf Basis der Chunks; <<#CCE0E8>>
  :Zitate anfügen:
  Norm, Fassung, Gültigkeit, Quell-URL; <<#CCE0E8>>
}

:Antwort an Kunden; <<#CCE0E8>>

stop

@enduml
